# EcoLoop AI — Environment Configuration
# Copy this file to .env.local for local development

# Google Gemini / Vertex AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Project Configuration (Optional for Cloud Run / Firestore)
GOOGLE_CLOUD_PROJECT=ecoloop-ai-hackathon
GCS_BUCKET_NAME=ecoloop-evidence-vault

# Application Settings
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (Simulates Gemini AI when GEMINI_API_KEY is not provided, allowing zero-friction testing)
ENABLE_DEMO_MODE=true

# Admin / Collector PIN for simulated verification demonstration
COLLECTOR_ADMIN_PIN=1234
